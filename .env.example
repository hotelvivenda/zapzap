# Porta e endereço. Em produção o Caddy (HTTPS) fica na frente; o CRM escuta só localmente.
PORT=3000
HOST=127.0.0.1

# Senha de acesso. Gere o hash com:  echo -n "sua-senha" | npm run set-password
CRM_PASSWORD_HASH=
# Alternativa simples só para testar no seu computador (não use em servidor):
# CRM_PASSWORD=

# "mock" = mensagens de teste (padrão). "cloud" = API oficial do WhatsApp (Meta).
WHATSAPP_PROVIDER=mock
# Só necessário com WHATSAPP_PROVIDER=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-senha-qualquer
WHATSAPP_APP_SECRET=
